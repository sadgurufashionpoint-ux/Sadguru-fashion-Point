@page
@model IndexModel
@{
    ViewData["Title"] = "Sadguru Fashion Point";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Sadguru Fashion Point</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fff8f5;
            color: #333;
        }

        /* HEADER */

        header {
            background: #d34aaa;
            color: white;
            text-align: center;
            padding: 25px 15px;
        }

        header h1 {
            font-size: 34px;
            margin-bottom: 8px;
        }

        header p {
            font-size: 18px;
        }

        /* NAVBAR */

        nav {
            background: #5c1732;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ffd1df;
        }

        /* HERO */

        .hero {
            text-align: center;
            padding: 70px 20px;
            background: #ffe4ec;
        }

        .hero h2 {
            color: #8e244d;
            font-size: 38px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 19px;
            line-height: 1.7;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background: #190001;
            color: white;
            padding: 13px 28px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: bold;
        }

        .btn:hover {
            background: #5c1732;
        }

        /* SECTION */

        .section {
            padding: 50px 20px;
            text-align: center;
        }

        .section h2 {
            color: #8e244d;
            font-size: 30px;
            margin-bottom: 30px;
        }

        /* CARDS */

        .cards {
            display: flex;
            justify-content: center;
            align-items: stretch;
            gap: 25px;
            flex-wrap: wrap;
        }

        .card {
            background: white;
            width: 300px;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-7px);
        }

        .card h3 {
            color: #8e244d;
            font-size: 21px;
            margin: 15px 0 10px;
        }

        .card p {
            line-height: 1.6;
            font-size: 16px;
        }

        /* ALL DESIGN IMAGES */

        .design-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            border-radius: 12px;
            display: block;
        }

        /* AARI */

        .aari-box {
            background: #fff0f4;
        }

        /* ABOUT */

        .about {
            background: #fff089;
        }

        .about p {
            max-width: 750px;
            margin: auto;
            font-size: 18px;
            line-height: 1.8;
        }

        /* CONTACT */

        .contact {
            background: #252525;
            color: white;
        }

        .contact h2 {
            color: white;
        }

        .contact p {
            font-size: 20px;
            margin: 12px;
        }

        .contact .btn {
            background: white;
            color: #8e244d;
        }

        .contact .btn:hover {
            background: #ffdce7;
        }

        /* FOOTER */

        footer {
            background: #5c1732;
            color: white;
            text-align: center;
            padding: 18px;
        }

        /* MOBILE */

        @@media (max-width: 600px) {

            header h1 {
                font-size: 26px;
            }

            header p {
                font-size: 15px;
            }

            nav a {
                margin: 0 7px;
                font-size: 14px;
            }

            .hero {
                padding: 50px 15px;
            }

            .hero h2 {
                font-size: 28px;
            }

            .hero p {
                font-size: 16px;
            }

            .card {
                width: 95%;
            }

            .design-image {
                height: 320px;
            }

        }

    </style>

</head>

<body>

